# AgentFlow server configuration. Offline demos and tests do not require any
# of these; everything is optional with documented defaults.

# --- Run modes -------------------------------------------------------------
# AGENTFLOW_PROVIDER selects the provider for POST /api/runs "task" mode:
#   unset        -> task mode returns 409 PROVIDER_NOT_CONFIGURED
#   openai-compat-> OpenAI-compatible endpoint (needs the three keys below)
# Scenario mode ("simple"/"compaction") always uses the offline fake provider.
AGENTFLOW_PROVIDER=
AGENTFLOW_MODEL=
AGENTFLOW_BASE_URL=
AGENTFLOW_API_KEY=
# HTTP deadline for the optional OpenAI-compatible adapter (seconds).
AGENTFLOW_TIMEOUT_SECONDS=30

# --- Task runs -------------------------------------------------------------
# Operator-declared tools: a Python module (dotted path or file path) with a
# module-level TOOLS sequence. See examples/agentflow_tools.py. Loading
# executes the module: it is trusted, operator-configured code.
AGENTFLOW_TOOLS_MODULE=
# Context budget for task runs (deterministic estimator tokens).
AGENTFLOW_MAX_CONTEXT_TOKENS=4000
AGENTFLOW_RESERVED_OUTPUT_TOKENS=200
# Per-call deadlines for task runs (seconds; loop-level TimeoutPolicy).
AGENTFLOW_PROVIDER_TIMEOUT_SECONDS=60
AGENTFLOW_TOOL_TIMEOUT_SECONDS=30

# --- Storage ---------------------------------------------------------------
AGENTFLOW_DB_PATH=.agentflow/agentflow.db
